{
  "name": "designspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "#lib/components/*": "./src/lib/designspace/components/*",
    "#lib/tokens/*": "./src/lib/designspace/tokens/*",
    "#lib/styles/*": "./src/lib/designspace/styles/*"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
